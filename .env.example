# Konfigurasi Koneksi PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# Konfigurasi Face Recognition & Detection
SIMILARITY_THRESHOLD=0.55
MIN_DIFF_THRESHOLD=0.05
DETECTION_SIZE=640

# Konfigurasi Geofencing Absensi
KELAS_LAT=-6.9828
KELAS_LON=110.4091
BATAS_RADIUS_METER=50
GPS_MOCK_LAT=-6.9828
GPS_MOCK_LON=110.4091

# Konfigurasi Cooldown Absensi (detik)
COOLDOWN_ABSEN_DETIK=15

